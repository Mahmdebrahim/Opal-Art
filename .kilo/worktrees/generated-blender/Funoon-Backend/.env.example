# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
FRONTEND_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/funoon_dev

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=90d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
USE_CLOUD_STORAGE=false

# MyFatoorah
MYFATOORAH_API_KEY=your_myfatoorah_api_key
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_WEBHOOK_SECRET=your_webhook_secret
MYFATOORAH_CURRENCY=SAR

# SMSA
SMSA_API_KEY=your_smsa_api_key
SMSA_API_URL=https://api.smsaexpress.com
SMSA_ACCOUNT_NUMBER=your_smsa_account_number

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Funoon.sa <noreply@funoon.sa>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173

# Cron Jobs
AUTO_COMPLETE_ORDER_HOURS=72
SUBSCRIPTION_RENEWAL_CHECK_DAYS=7
